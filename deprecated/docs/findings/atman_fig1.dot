
digraph AtmanFigure1 {
  graph [rankdir=LR, splines=ortho, overlap=false, pad="0.25",
         nodesep="0.35", ranksep="0.85", bgcolor="white",
         fontname="Helvetica", fontsize=14, labelloc="t",
         label="Atman: multiscale, stability- and uncertainty-aware inference"];

  node [shape=box, style="rounded,filled", fontname="Helvetica",
        fontsize=10, margin="0.10,0.06", color="#334155", penwidth=1.2];

  edge [color="#64748b", arrowsize=0.7, penwidth=1.2];

  raw [label="Raw data", fillcolor="#fef3c7"];
  ingest [label="Ingest", fillcolor="#fde68a"];
  qc [label="QC", fillcolor="#fde68a"];
  de [label="Differential abundance", fillcolor="#bfdbfe", penwidth=2];
  mod [label="Module inference", fillcolor="#bbf7d0", penwidth=2];
  boot [label="Bootstrap uncertainty
P(sign stable)", fillcolor="#fbcfe8", penwidth=2];
  out [label="Outputs", fillcolor="#e5e7eb"];

  raw -> ingest -> qc -> de -> mod -> boot -> out;
}
